# Copy this file to `.env` for local overrides. Never commit `.env`.
# Graded exercises and CI use LLM_PROVIDER=fake (no network, no paid API).

# Provider switch (Java analogy: a Spring profile).
# fake = deterministic, no network. ollama = local. openai = paid API, optional.
# If you opt into openai, generation uses the Responses API
# (client.responses.create). Embeddings use client.embeddings.create.
# Never the sunset Assistants API.
LLM_PROVIDER=fake

# Uncomment only for your own paid-API experiments. Leave empty for the core course.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional local model name used by examples/gradio_app.py
# OLLAMA_MODEL=llama3.2:1b

# DocsDesk mock service (fixture transport when host ends with .internal.test)
# DOCS_BASE_URL=https://docs.internal.test

# Token prices for cost exercises live in data/pricing.yaml (dated, public rates).
# Never put keys in that file.
